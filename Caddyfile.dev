# Dev reverse proxy: `caddy run --config Caddyfile.dev`
# Caddy issues a local CA cert for localhost; browsers treat it as a secure
# context, which WebAuthn requires. Start the app with:
#   go run . serve -origin https://localhost
localhost {
	header Strict-Transport-Security "max-age=31536000"
	# Single-tenant dev box: no proxy secret needed (gk falls back to trusting
	# a loopback peer). We still overwrite XFF with the real peer so the
	# rate-limiter sees per-client IPs rather than a client-supplied value.
	reverse_proxy 127.0.0.1:8087 {
		header_up X-Forwarded-For {remote_host}
	}
}
